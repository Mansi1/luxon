{
  "name": "luxon",
  "version": "3.7.2",
  "description": "Immutable date wrapper",
  "author": "Isaac Cambron",
  "type": "module",
  "keywords": [
    "date",
    "immutable"
  ],
  "repository": "https://github.com/moment/luxon",
  "exports": {
    ".": {
      "import": "./build/es6/luxon.mjs",
      "require": "./build/node/luxon.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "yarn@4.10.2",
  "scripts": {
    "prebuild": "rm -rf ./build",
    "build:types": "tsc --build",
    "build:js": "rollup -c",
    "build": "yarn build:types && yarn build:js",
    "prepack": "npm run build",
    "jest": "jest",
    "test": "jest --coverage"
  },
  "lint-staged": {
    "*.{js,ts,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/node": "^7.18.6",
    "@babel/plugin-external-helpers": "^7.18.6",
    "@babel/preset-env": "^7.18.6",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "babel-jest": "^28.1.2",
    "benchmark": "latest",
    "codecov": "latest",
    "documentation": "latest",
    "http-server": "^14.1.1",
    "husky": "^7.0.0",
    "jest": "^29.4.3",
    "lint-staged": "^13.2.1",
    "prettier": "latest",
    "rollup": "^4.52.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.9.2"
  },
  "main": "build/node/luxon.js",
  "module": "build/es6/luxon.js",
  "browser": "build/cjs-browser/luxon.js",
  "jsdelivr": "build/global/luxon.min.js",
  "unpkg": "build/global/luxon.min.js",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "sideEffects": false
}
